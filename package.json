{
  "name": "tapas-ui",
  "version": "0.1.0",
  "description": "Six copy-paste card components built with React, TypeScript and Tailwind CSS on shadcn/ui, with a live demo",
  "keywords": [
    "tapas-ui",
    "ui",
    "components",
    "react",
    "typescript",
    "tailwind",
    "nextjs"
  ],
  "homepage": "https://tapasui.tahmid.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tahmidbintaslim/tapas-ui.git"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "shadcn build && storybook build -o public/storybook --quiet && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry:build": "shadcn build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "lucide-react": "^0.525.0",
    "motion": "14.3.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-designs": "12.0.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/nextjs": "10.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "chromatic": "18.13.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-storybook": "10.6.2",
    "jsdom": "29.1.1",
    "shadcn": "^4.23.0",
    "storybook": "10.6.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "bugs": {
    "url": "https://github.com/tahmidbintaslim/tapas-ui/issues"
  }
}
